# Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Upstream endpoints (env cascade: ANTHROPIC_UPSTREAM_* → ROUTER_BASE_*) ---
# Anthropic-format upstream (cho /v1/messages — Claude Code)
ANTHROPIC_UPSTREAM_BASE=""
ANTHROPIC_UPSTREAM_KEY=""

# OpenAI-format upstream (cho /v1/chat/completions và /v1/responses — Codex/Chat)
OPENAI_UPSTREAM_BASE=""
OPENAI_UPSTREAM_KEY=""

# Legacy fallback (dùng khi ANTHROPIC_UPSTREAM_BASE / OPENAI_UPSTREAM_BASE không set)
ROUTER_BASE_URL=""
ROUTER_API_KEY=""

# --- Fallback endpoints mẫu (DB field fallbackEndpoints của Model) ---
# Khi upstream primary fail (5xx/network error), tự động fallback qua model khác.
# Ghi tên model (có trong DB):
#   ["claude-sonnet-4-0", "gpt-4o"]
#   hoặc
#   [{"modelName": "claude-sonnet-4-0"}, {"modelName": "gpt-4o"}]
# Runtime tự lấy endpoint + apiKey của model đó. Setting trong admin UI.

# App
APP_URL="https://lccaptcha.io.vn"
GATEWAY_BASE_URL="https://lccaptcha.io.vn"
CODEX_BASE_URL="https://lccaptcha.io.vn"
CLAUDE_CODE_BASE_URL="https://lccaptcha.io.vn"
ADMIN_EMAIL="admin@local.dev"
ADMIN_PASSWORD="admin123"