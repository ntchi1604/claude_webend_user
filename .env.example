# Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Upstream router
ROUTER_BASE_URL="http://localhost:8000"
ROUTER_API_KEY=""

# App
APP_URL="https://lccaptcha.io.vn"
GATEWAY_BASE_URL="https://lccaptcha.io.vn"
