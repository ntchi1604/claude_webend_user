# Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Upstream (direct, bypass local router) ---
# Anthropic-format upstream (cho /v1/messages — Claude Code)
ANTHROPIC_UPSTREAM_BASE="https://api-cc.freemodel.dev"  # T1+ nhanh hơn, hoặc https://cc.freemodel.dev
ANTHROPIC_UPSTREAM_KEY="fe_oa_xxxxxxxxxxxxxxxx"

# OpenAI-format upstream (cho /v1/chat/completions và /v1/responses — Codex/Chat)
OPENAI_UPSTREAM_BASE="https://vip-sg.freemodel.dev"    # T1+ Singapore, hoặc https://api.freemodel.dev
OPENAI_UPSTREAM_KEY="fe_oa_xxxxxxxxxxxxxxxx"

# Legacy fallback (chỉ dùng nếu 2 cặp trên không set)
ROUTER_BASE_URL=""
ROUTER_API_KEY=""

# App
APP_URL="https://lccaptcha.io.vn"
GATEWAY_BASE_URL="https://lccaptcha.io.vn"
CODEX_BASE_URL="https://lccaptcha.io.vn"
CLAUDE_CODE_BASE_URL="https://lccaptcha.io.vn"
ADMIN_EMAIL="admin@local.dev"
ADMIN_PASSWORD="admin123"